// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  password           String
  phoneNumber        String             @unique
  status             UserStatus         @default(ACTIVE)
  roleId             String
  role               Role               @relation(fields: [roleId], references: [id])
  insuranceCompanyId String?            
  insuranceCompany   InsuranceCompany?  @relation(fields: [insuranceCompanyId], references: [companyId])
  isDefaultPassword  Boolean            @default(true)
  OTP_number         String?
  OTP_life_time      DateTime?
  lastLogin          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  @@map("users") 
  Claim Claim[]
}


model Role {
  id            String   @id @default(uuid())
  name          String   @unique  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  users         User[]   // A Role can have many users
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model InsuranceCompany {
  companyId           String   @id @default(uuid())
  name                String   @unique
  email        String   @unique
  policyNumberPrefix  String
  isActive           Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt


  // Relations
  representatives    User[]  

  Claim Claim[]
}

enum ClaimStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

model Claim {
  claimId        String          @id @default(uuid())
  submissionDate DateTime        @default(now())
  status         ClaimStatus     @default(SUBMITTED)
  description    String?
  
  submittedById  String
  submittedBy    User            @relation(fields: [submittedById], references: [id])
  @@index([submittedById])
 
  companyId      String
  company        InsuranceCompany @relation(fields: [companyId], references: [companyId])
  @@index([companyId])

  
  documents      Document[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("claims")
}

enum DocumentType {
  REPORT
  INVOICE
  RECEIPT
  CONTRACT
  IMAGE
  OTHER
}

model Document {
  documentId   String       @id @default(uuid())  
  documentType DocumentType
  filePath     String
  uploadDate   DateTime     @default(now())

  
  claimId      String
  claim        Claim        @relation(fields: [claimId], references: [claimId])
  @@index([claimId])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("documents")
}
