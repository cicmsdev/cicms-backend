// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  password           String
  phoneNumber        String             @unique
  status             UserStatus         @default(ACTIVE)
  roleId             String
  role               Role               @relation(fields: [roleId], references: [id])
  insuranceCompanyId String?            
  insuranceCompany   InsuranceCompany?  @relation(fields: [insuranceCompanyId], references: [companyId])
  isDefaultPassword  Boolean            @default(true)
  OTP_number         String?
  OTP_life_time      DateTime?
  lastLogin          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  @@map("users") 
 
  submittedClaims    Claim[]            @relation("SubmittedBy")
  assignedClaims     Claim[]            @relation("Evaluator")
  uploadedDocuments  Document[]
  activities         ClaimActivity[] @relation("ActivityPerformedBy")
}


model Role {
  id            String   @id @default(uuid())
  name          String   @unique  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  users         User[]   
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model InsuranceCompany {
  companyId           String   @id @default(uuid())
  name                String   @unique
  email        String   @unique
  policyNumberPrefix  String
  isActive           Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt


  // Relations
  representatives    User[]  

  Claims  Claim[]
}

enum ClaimStatus {
  SUBMITTED  
  APPROVED
  REJECTED
  IN_EVALUATION
  RESOLVED
  RESOLVED_IN_COURT
}

model Claim {
  claimId        String          @id @default(uuid())
  submissionDate DateTime        @default(now())
  status         ClaimStatus     @default(SUBMITTED)
  ClaimTitle     String
  
  
  submittedById  String
  submittedBy    User            @relation("SubmittedBy", fields: [submittedById], references: [id])
  @@index([submittedById])
 
  companyId      String
  company        InsuranceCompany @relation(fields: [companyId], references: [companyId])
  @@index([companyId])

  evaluatorId String?
  evaluator   User?    @relation("Evaluator", fields: [evaluatorId], references: [id])
  @@index([evaluatorId])


  
  documents      Document[]
  activities  ClaimActivity[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("claims")
}

model ClaimActivity {
  id            String       @id @default(cuid())
  claim         Claim        @relation(fields: [claimId], references: [claimId])
  claimId       String
  performedBy   User?        @relation("ActivityPerformedBy", fields: [performedById], references: [id])
  performedById String?
  action        String       // e.g. "STATUS_UPDATE"
  fromStatus    ClaimStatus?
  toStatus      ClaimStatus?
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([claimId, createdAt])
}

enum DocumentType {
  DAMAGE_REPORT
  POLICE_REPORT
  SITE_INSPECTION_REPORT
  LAND_OWNERSHIP_PROOF

}

model Document {
  documentId   String       @id @default(uuid())  
  documentType DocumentType
  filePath     String
  uploadDate   DateTime     @default(now())

  
  claimId      String
  claim        Claim        @relation(fields: [claimId], references: [claimId])
  @@index([claimId])

  uploaderId  String
  uploader    User         @relation(fields: [uploaderId], references: [id])
  @@index([uploaderId])


  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("documents")
}
